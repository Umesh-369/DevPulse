# DevPulse Backend Environment Variables

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/devpulse
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters

# Application URLs
# Local: http://localhost:5173 | Production (Vercel): https://your-devpulse-app.vercel.app
CLIENT_URL=http://localhost:5173
# Local: http://localhost:5000 | Production (Render): https://<your-render-service>.onrender.com
SERVER_URL=http://localhost:5000

# GitHub OAuth 2.0
# Create at https://github.com/settings/developers -> OAuth Apps
# Authorization callback URL: ${SERVER_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# Optional: defaults to ${SERVER_URL}/api/auth/github/callback
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Google OAuth 2.0
# Create at https://console.cloud.google.com/apis/credentials -> OAuth 2.0 Client IDs
# Authorized redirect URIs: ${SERVER_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Optional: defaults to ${SERVER_URL}/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# OpenRouter AI
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

